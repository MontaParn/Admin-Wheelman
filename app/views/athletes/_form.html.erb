<%= form_with model: athlete, class: "space-y-5 max-w-lg bg-white rounded-2xl border border-gray-100 shadow-sm p-8" do |f| %>
  <% if athlete.errors.any? %>
    <div class="rounded-xl bg-red-50 border border-red-100 px-4 py-3 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% athlete.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "ชื่อ", class: field_label_class %>
    <%= f.text_field :name, class: field_input_class %>
    <%= field_helper_text "ชื่อเต็มของนักกีฬา" %>
  </div>

  <div>
    <%= f.label :phone, "เบอร์โทร", class: field_label_class %>
    <%= f.text_field :phone, class: field_input_class %>
    <%= field_helper_text "ใช้ติดต่อกรณีจำเป็น" %>
  </div>

  <div>
    <%= f.label :line_user_id, "LINE User ID", class: field_label_class %>
    <%= f.text_field :line_user_id, class: field_input_class %>
    <%= field_helper_text "ใช้สำหรับส่งข้อความเตือนผ่าน LINE" %>
  </div>

  <div>
    <%= f.label :started_on, "วันที่เริ่มเทรน", class: field_label_class %>
    <%= f.date_field :started_on, class: field_input_class %>
    <%= field_helper_text "ใช้คำนวณระยะเวลาที่เทรนมาแล้ว" %>
  </div>

  <div>
    <%= f.label :notes, "บันทึกเพิ่มเติม", class: field_label_class %>
    <%= f.text_area :notes, rows: 3, class: field_input_class %>
    <%= field_helper_text "บันทึกเพิ่มเติมเกี่ยวกับนักกีฬา (ถ้ามี)" %>
  </div>

  <div>
    <%= toggle_switch f, :active, "ยังเทรนอยู่" %>
  </div>

  <%= f.submit "บันทึก", class: "rounded-xl bg-green-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-green-700 cursor-pointer" %>
<% end %>
