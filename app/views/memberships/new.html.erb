<% content_for :title, "สมัครแพคเกจ - #{@athlete.name}" %>

<%= back_link athlete_path(@athlete) %>

<h1 class="text-2xl font-bold mb-6">สมัคร/ต่อแพคเกจ - <%= @athlete.name %></h1>

<%= form_with model: @membership, url: athlete_memberships_path(@athlete), class: "space-y-5 max-w-lg bg-white rounded-2xl border border-gray-100 shadow-sm p-8" do |f| %>
  <% if @membership.errors.any? %>
    <div class="rounded-xl bg-red-50 border border-red-100 px-4 py-3 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% @membership.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :package_plan_id, "แพคเกจ", class: field_label_class %>
    <%= render "shared/custom_select", form: f, attribute: :package_plan_id,
        options: [ [ "เลือกแพคเกจ", "" ] ] + @package_plans.map { |plan| [ "#{plan.name} - #{number_to_currency(plan.price, unit: '฿', format: '%u%n')}", plan.id ] } %>
    <%= field_helper_text "ระบบจะคำนวณวันหมดอายุและยอดชำระให้อัตโนมัติ" %>
  </div>

  <div>
    <%= f.label :start_date, "วันที่เริ่ม", class: field_label_class %>
    <%= f.date_field :start_date, class: field_input_class %>
    <%= field_helper_text "วันที่เริ่มนับอายุแพคเกจ" %>
  </div>

  <%= f.submit "บันทึก", class: "rounded-xl bg-green-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-green-700 cursor-pointer" %>
<% end %>
