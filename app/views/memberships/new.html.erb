<% content_for :title, "สมัครแพคเกจ - #{@athlete.name}" %>

<h1 class="text-2xl font-bold mb-6">สมัคร/ต่อแพคเกจ - <%= @athlete.name %></h1>

<%= form_with model: @membership, url: athlete_memberships_path(@athlete), class: "space-y-4 max-w-lg" do |f| %>
  <% if @membership.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc list-inside">
        <% @membership.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :package_plan_id, "แพคเกจ", class: "block text-sm font-medium text-gray-700" %>
    <%= f.collection_select :package_plan_id, @package_plans, :id, ->(plan) { "#{plan.name} - #{number_to_currency(plan.price, unit: '฿', format: '%u%n')}" }, { prompt: "เลือกแพคเกจ" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div>
    <%= f.label :start_date, "วันที่เริ่ม", class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_field :start_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <%= f.submit "บันทึก", class: "rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 cursor-pointer" %>
<% end %>
