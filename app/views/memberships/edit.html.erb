<% content_for :title, "แก้ไขแพคเกจ - #{@athlete.name}" %>

<h1 class="text-2xl font-bold mb-6">แก้ไขแพคเกจ - <%= @athlete.name %></h1>
<p class="text-sm text-gray-500 mb-4"><%= @membership.package_plan.name %></p>

<%= form_with model: @membership, url: athlete_membership_path(@athlete, @membership), class: "space-y-4 max-w-lg" do |f| %>
  <% if @membership.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc list-inside">
        <% @membership.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :start_date, "วันที่เริ่ม", class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_field :start_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div>
    <%= f.label :end_date, "วันหมดอายุ", class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_field :end_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div>
    <%= f.label :cancelled_at, "ยกเลิกเมื่อ (เว้นว่างถ้ายังไม่ยกเลิก)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.datetime_field :cancelled_at, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <%= f.submit "บันทึก", class: "rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 cursor-pointer" %>
<% end %>
