<% content_for :title, "จัดการแพคเกจ" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">จัดการแพคเกจ</h1>
  <%= link_to "เพิ่มแพคเกจ", new_package_plan_path, class: "rounded-xl bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700" %>
</div>

<div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">ชื่อแพคเกจ</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">ชนิดกีฬา</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">รอบชำระ</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">ราคา</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">สถานะ</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @package_plans.each do |plan| %>
        <tr>
          <td class="px-4 py-3 font-medium text-gray-900"><%= plan.name %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= plan.disciplines.join(" + ") %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= plan.billing_cycle_label %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= number_to_currency plan.price, unit: "฿", format: "%u%n" %></td>
          <td class="px-4 py-3">
            <% if plan.active? %>
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-green-100 text-green-800">เปิดใช้งาน</span>
            <% else %>
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-gray-100 text-gray-600">ปิดใช้งาน</span>
            <% end %>
          </td>
          <td class="px-4 py-3">
            <div class="flex items-center justify-end gap-4 whitespace-nowrap">
              <%= link_to edit_package_plan_path(plan), class: "inline-flex items-center gap-1 text-xs text-green-700 hover:underline" do %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5">
                  <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" />
                  <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" />
                </svg>
                แก้ไข
              <% end %>
              <%= button_to package_plan_path(plan), method: :delete, data: { turbo_confirm: "ลบแพคเกจ \"#{plan.name}\"?" }, class: "inline-flex items-center gap-1 text-xs text-red-600 hover:underline cursor-pointer bg-transparent border-0 p-0" do %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5">
                  <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" />
                </svg>
                ลบ
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @package_plans.empty? %>
        <tr>
          <td colspan="6" class="px-4 py-6 text-center text-sm text-gray-400">ยังไม่มีแพคเกจ</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
