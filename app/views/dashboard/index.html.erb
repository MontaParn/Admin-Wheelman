<% content_for :title, "แดชบอร์ด" %>

<h1 class="text-2xl font-bold mb-6">แพคเกจที่ใกล้หมดอายุ (ภายใน 7 วัน)</h1>

<div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">นักกีฬา</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">แพคเกจ</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">หมดอายุ</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500">เหลือ</th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @memberships.each do |membership| %>
        <tr>
          <td class="px-4 py-3"><%= link_to membership.athlete.name, membership.athlete, class: "font-medium text-gray-900 hover:underline" %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= membership.package_plan.name %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= membership.end_date.strftime("%d %b %Y") %></td>
          <td class="px-4 py-3 text-sm text-gray-500"><%= membership.days_until_expiry %> วัน</td>
          <td class="px-4 py-3">
            <%= render "memberships/reminder_status", membership: membership %>
          </td>
        </tr>
      <% end %>
      <% if @memberships.empty? %>
        <tr>
          <td colspan="5" class="px-4 py-6 text-center text-sm text-gray-400">ไม่มีแพคเกจที่ใกล้หมดอายุ</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
