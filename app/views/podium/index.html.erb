<% content_for :title, "Podium" %>

<h1 class="text-2xl font-bold mb-6">Podium</h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <section class="rounded-lg border border-gray-200 bg-white p-4">
    <h2 class="text-lg font-semibold mb-3">🏅 เทรนมานานสุด</h2>
    <ol class="space-y-2">
      <% @by_tenure.each.with_index(1) do |athlete, rank| %>
        <li class="flex items-center justify-between text-sm">
          <span><span class="text-gray-400 mr-2">#<%= rank %></span><%= link_to athlete.name, athlete, class: "hover:underline" %></span>
          <span class="text-gray-500"><%= athlete.tenure_days / 30 %> เดือน</span>
        </li>
      <% end %>
      <% if @by_tenure.empty? %>
        <li class="text-sm text-gray-400">ยังไม่มีข้อมูล</li>
      <% end %>
    </ol>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-4">
    <h2 class="text-lg font-semibold mb-3">💸 จ่ายตรงเวลาสุด</h2>
    <ol class="space-y-2">
      <% @by_punctuality.each.with_index(1) do |athlete, rank| %>
        <li class="flex items-center justify-between text-sm">
          <span><span class="text-gray-400 mr-2">#<%= rank %></span><%= link_to athlete.name, athlete, class: "hover:underline" %></span>
          <span class="text-gray-500"><%= number_to_percentage(athlete.on_time_payment_rate * 100, precision: 0) %></span>
        </li>
      <% end %>
      <% if @by_punctuality.empty? %>
        <li class="text-sm text-gray-400">ยังไม่มีข้อมูล</li>
      <% end %>
    </ol>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-4">
    <h2 class="text-lg font-semibold mb-3">🏁 แข่งบ่อยสุด (ปีนี้)</h2>
    <ol class="space-y-2">
      <% @by_race_count.each.with_index(1) do |athlete, rank| %>
        <li class="flex items-center justify-between text-sm">
          <span><span class="text-gray-400 mr-2">#<%= rank %></span><%= link_to athlete.name, athlete, class: "hover:underline" %></span>
          <span class="text-gray-500"><%= athlete.race_count_this_year %> รายการ</span>
        </li>
      <% end %>
      <% if @by_race_count.empty? %>
        <li class="text-sm text-gray-400">ยังไม่มีข้อมูล</li>
      <% end %>
    </ol>
  </section>
</div>
