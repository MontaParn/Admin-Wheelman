<% content_for :title, "เพิ่มรายการแข่งขัน - #{@athlete.name}" %>

<h1 class="text-2xl font-bold mb-6">เพิ่มรายการแข่งขัน - <%= @athlete.name %></h1>

<%= form_with model: @race_entry, url: athlete_race_entries_path(@athlete), class: "space-y-4 max-w-lg" do |f| %>
  <% if @race_entry.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc list-inside">
        <% @race_entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :race_name, "ชื่อรายการแข่งขัน", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :race_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div>
    <%= f.label :race_date, "วันที่แข่ง", class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_field :race_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div>
    <%= f.label :discipline, "ประเภท", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :discipline, placeholder: "เช่น Olympic Triathlon", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div>
    <%= f.label :result, "ผลการแข่งขัน", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :result, placeholder: "เช่น อันดับ 3 / เวลา 2:15:30", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <%= f.submit "บันทึก", class: "rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 cursor-pointer" %>
<% end %>
